[Unit]
Description=HEART OF GOLD kiosk (Brave Origin on the iGPU)
Wants=marvind.service
After=marvind.service systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service
[Service]
User=heartofgold
Group=heartofgold
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
StateDirectory=heartofgold-kiosk
StateDirectoryMode=0700
Environment=HOME=/var/lib/heartofgold-kiosk
ExecStart=/usr/bin/xinit /opt/heartofgold/bin/heartofgold-kiosk-session -- :0 vt1 -nolisten tcp -keeptty -nocursor -s 0 -dpms
Restart=always
RestartSec=3
# Limits and device policy live on user-<uid>.slice (D-053): PAMName=login moves the session
# out of this unit's cgroup, so settings here would bind nothing.
[Install]
WantedBy=multi-user.target
