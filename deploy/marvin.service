[Unit]
Description=Marvin telemetry collector (HEART OF GOLD panel)
After=network.target

[Service]
Type=simple
User=marvin
Group=marvin
ExecStart=/opt/marvin/bin/marvind --addr 127.0.0.1:8080
Restart=always
RestartSec=3
WatchdogSec=60
MemoryMax=200M
CPUQuota=50%
TasksMax=64
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/marvin

[Install]
WantedBy=multi-user.target
