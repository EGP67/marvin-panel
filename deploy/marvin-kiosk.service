# Display side. Only meaningful once the panel is attached to the motherboard HDMI.
# --disable-gpu keeps raster on the CPU: the iGPU only scans out, the Nvidia cards stay free.
[Unit]
Description=Marvin panel kiosk
After=marvin.service graphical.target

[Service]
Type=simple
User=marvin
Environment=DISPLAY=:0
ExecStartPre=/bin/sh -c 'xset -display :0 s off; xset -display :0 -dpms'
ExecStart=/usr/bin/chromium --app=http://127.0.0.1:8080 --kiosk --disable-gpu \
  --noerrdialogs --disable-session-crashed-bubble --check-for-update-interval=31536000
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
